NODE_ENV="development"
PORT="4000"

# ─── Database ───────────────────────────────────────────────────────────────
# Local Docker (development):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edufuture?schema=public"
# Supabase (production) — replace the block above with your Supabase connection string:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

JWT_ACCESS_SECRET="replace-with-long-access-secret"
JWT_REFRESH_SECRET="replace-with-long-refresh-secret"
FRONTEND_URL="http://localhost:5174"

# Stripe (optional — mock mode if empty)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_DEFAULT_CURRENCY="kzt"

# ─── Supabase Storage (optional) ────────────────────────────────────────────
# When set, file uploads (avatars, covers, media) go to Supabase Storage.
# When NOT set, files are saved to the local ./uploads/ directory.
# Create buckets "avatars", "covers", and "media" in your Supabase project first.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
