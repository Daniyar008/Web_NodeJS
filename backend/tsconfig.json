{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "module": "Node16",
    "target": "es2022",
    "moduleResolution": "node16",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}